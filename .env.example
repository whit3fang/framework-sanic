# Copy to .env for local development. Beta/production values come from terraform.

# --- Dialpad
DIALPAD_CLIENT_ID=dev-client-id
DIALPAD_CLIENT_SECRET=dev-client-secret-change-me-0123456789
DIALPAD_SCOPES=recordings_export,message_content_export,calls:list,change_log
DIALPAD_IFRAME_URL=http://localhost:8000/app/
DIALPAD_API_BASE=https://dialpad.com
DIALPAD_FRAME_ORIGINS=https://dialpad.com,https://*.dialpad.com
DIALPAD_CALL_STATES=hangup,missed,voicemail,recording
LOGGABLE_TARGET_TYPES=user,department,callcenter
CHANGELOG_LIFECYCLE_ACTIONS=target_created,target_deleted
PLATFORM_ADAPTER=fake            # dialpad | fake

# --- Connector and features
CONNECTOR=fake                   # fake | hubspot
FEATURES=call_logging,sms_logging,fake.dev_harness   # comma separated; call_logging / sms_logging log calls / SMS to the connector
UNKNOWN_CALLER_POLICY=log_unassociated
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=

# --- Infrastructure
STORAGE_ADAPTER=sqlalchemy       # memory | sqlalchemy | datastore
DATABASE_URL=sqlite+aiosqlite:///./framework.db
DATASTORE_PROJECT=local-project
QUEUE_ADAPTER=memory             # memory | pubsub
CACHE_URL=redis://localhost:6379/0   # local dev uses Redis (`framework-sanic dev` starts one); memory:// runs without it
KMS_KEY=                         # projects/.../locations/.../keyRings/.../cryptoKeys/...; empty = local key
SHARD_COUNT=8
ACTIVITY_TTL_DAYS=90

# --- Service
PUBLIC_BASE_URL=http://localhost:8000
UI_ORIGINS=http://localhost:5173,http://localhost:8000
WEBHOOK_SECRET_KEY=dev-webhook-master-key
SESSION_SECRET=dev-session-secret-change-me-32bytes
EMBEDDED_WORKERS=true
