    "ManifestField": {
      "properties": {
        "key": {
          "title": "Key",
          "type": "string"
        },
        "kind": {
          "default": "text",
          "enum": [
            "text",
            "email",
            "phone",
            "url",
            "date"
          ],
          "title": "Kind",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        }
      },
      "required": [
        "key",
        "label"
      ],
      "title": "ManifestField",
      "type": "object"
    },
    "NoteIn": {
      "description": "A note a user wrote in the contact card about a call (``POST /notes``). Not stored by the\nframework: it goes to the integration's ``NoteListener``.",
      "properties": {
        "body": {
          "maxLength": 10000,
          "minLength": 1,
          "title": "Body",
          "type": "string"
        },
        "call_id": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Call Id",
          "type": "string"
        },
        "dialpad_ref": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dialpad Ref"
        },
        "note_id": {
          "description": "Client-generated; retries with the same id are idempotent",
          "pattern": "^[A-Za-z0-9_-]{8,64}$",
          "title": "Note Id",
          "type": "string"
        }
      },
      "required": [
        "note_id",
        "call_id",
        "body"
      ],
      "title": "NoteIn",
      "type": "object"
    },
    "NoteOut": {
      "properties": {
        "call_id": {
          "title": "Call Id",
          "type": "string"
        },
        "note_id": {
          "title": "Note Id",
          "type": "string"
        },
        "synced": {
          "default": false,
          "title": "Synced",
          "type": "boolean"
        }
      },
      "required": [
        "note_id",
        "call_id"
      ],
      "title": "NoteOut",
      "type": "object"
    },
    "Queued": {
      "properties": {
        "queued": {
          "default": true,
          "title": "Queued",
          "type": "boolean"
        }
      },
      "title": "Queued",
      "type": "object"
    },
    "RematchIn": {
      "properties": {
        "confirm_forward_only": {
          "default": false,
          "title": "Confirm Forward Only",
          "type": "boolean"
        },
        "dialpad_ref": {
          "maxLength": 200,
          "minLength": 3,
          "title": "Dialpad Ref",
          "type": "string"
