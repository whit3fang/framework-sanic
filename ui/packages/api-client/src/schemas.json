        "external_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "External Id",
          "type": "string"
        },
        "external_type": {
          "maxLength": 100,
          "minLength": 1,
          "title": "External Type",
          "type": "string"
        }
      },
      "required": [
        "dialpad_ref",
        "external_id",
        "external_type"
      ],
      "title": "RematchIn",
      "type": "object"
    },
    "RematchOut": {
      "properties": {
        "applies_to": {
          "default": "future_activities_only",
