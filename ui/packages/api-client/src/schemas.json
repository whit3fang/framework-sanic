      },
      "required": [
        "q"
      ],
      "title": "SearchQuery",
      "type": "object"
    },
    "SessionIn": {
      "properties": {},
      "title": "SessionIn",
      "type": "object"
    },
    "SessionOut": {
      "properties": {
        "admin_notice": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Admin Notice"
        },
        "company_id": {
          "title": "Company Id",
          "type": "string"
        },
        "connector": {
          "title": "Connector",
          "type": "string"
        },
        "dialpad_connect_url": {
          "title": "Dialpad Connect Url",
          "type": "string"
        },
        "expires_at": {
          "title": "Expires At",
          "type": "number"
        },
        "external": {
          "additionalProperties": {
            "type": "boolean"
          },
          "title": "External",
          "type": "object"
        },
        "features": {
          "items": {
            "type": "string"
          },
          "title": "Features",
          "type": "array"
        },
        "is_admin": {
          "title": "Is Admin",
          "type": "boolean"
        },
        "manifest": {
          "$ref": "#/$defs/UiManifest"
        },
        "notes": {
          "default": false,
          "title": "Notes",
          "type": "boolean"
        },
        "session_token": {
          "title": "Session Token",
          "type": "string"
        },
        "state": {
          "enum": [
            "needs_admin_connect",
            "awaiting_admin",
            "needs_external_connect",
            "ready",
            "forbidden"
          ],
          "title": "State",
          "type": "string"
        },
        "user_id": {
          "title": "User Id",
          "type": "string"
        }
      },
      "required": [
        "state",
        "company_id",
        "user_id",
        "is_admin",
        "external",
        "session_token",
        "expires_at",
        "manifest",
        "dialpad_connect_url",
        "connector",
        "features"
      ],
      "title": "SessionOut",
      "type": "object"
    },
    "TargetOut": {
      "properties": {
        "effective_enabled": {
          "title": "Effective Enabled",
          "type": "boolean"
        },
        "name": {
          "title": "Name",
