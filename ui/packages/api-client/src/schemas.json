    "UiManifest": {
      "description": "Drives the manifest-based contact card; the UI has no connector-specific code.",
      "properties": {
        "connector": {
          "title": "Connector",
          "type": "string"
        },
        "create_fields": {
          "items": {
            "$ref": "#/$defs/ManifestField"
          },
          "title": "Create Fields",
          "type": "array"
        },
        "display_name": {
          "title": "Display Name",
          "type": "string"
        },
        "fields": {
          "items": {
            "$ref": "#/$defs/ManifestField"
          },
          "title": "Fields",
          "type": "array"
        },
        "link_out_template": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Link Out Template"
        },
        "object_label": {
          "default": "Contact",
          "title": "Object Label",
          "type": "string"
        },
        "search_placeholder": {
          "default": "Search by name, email or phone",
          "title": "Search Placeholder",
          "type": "string"
        }
      },
      "required": [
        "connector",
        "display_name",
        "fields"
      ],
      "title": "UiManifest",
      "type": "object"
    },
    "UninstallOut": {
      "properties": {
        "records_deleted": {
          "title": "Records Deleted",
          "type": "integer"
        },
        "subscriptions_removed": {
          "title": "Subscriptions Removed",
          "type": "integer"
        }
      },
      "required": [
        "records_deleted",
        "subscriptions_removed"
