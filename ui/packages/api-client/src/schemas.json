        "candidates": {
          "items": {
            "$ref": "#/$defs/Entity"
          },
          "title": "Candidates",
          "type": "array"
        },
        "dialpad_ref": {
          "title": "Dialpad Ref",
          "type": "string"
        },
        "entity": {
          "anyOf": [
            {
              "$ref": "#/$defs/Entity"
            },
            {
              "type": "null"
            }
          ]
        },
        "manifest": {
          "$ref": "#/$defs/UiManifest"
        }
      },
      "required": [
        "dialpad_ref",
        "entity",
        "candidates",
        "manifest"
      ],
      "title": "ContactOut",
      "type": "object"
    },
    "ContactQuery": {
      "properties": {
        "dialpad_ref": {
          "maxLength": 200,
          "minLength": 3,
          "title": "Dialpad Ref",
          "type": "string"
        },
        "phone": {
          "anyOf": [
            {
              "maxLength": 40,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Phone"
        }
      },
      "required": [
        "dialpad_ref"
      ],
      "title": "ContactQuery",
      "type": "object"
    },
    "CreateContactIn": {
      "properties": {
        "dialpad_ref": {
          "maxLength": 200,
          "minLength": 3,
          "title": "Dialpad Ref",
          "type": "string"
        },
        "properties": {
          "additionalProperties": true,
          "title": "Properties",
          "type": "object"
        }
      },
      "required": [
        "dialpad_ref",
        "properties"
      ],
      "title": "CreateContactIn",
      "type": "object"
    },
    "Empty": {
      "properties": {},
